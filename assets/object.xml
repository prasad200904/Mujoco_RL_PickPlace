<mujoco>
  <!--
    Movable cube + target marker.
    Cube: 5 cm edge (half-size 0.025), 0.1 kg, free joint -> rests at z = 0.425 on the table.
    Target: a flat, non-colliding marker on a mocap body, so its position can be changed
    at runtime (data.mocap_pos) without affecting physics.
  -->
  <asset>
    <material name="cube_mat" rgba="0.85 0.15 0.15 1" specular="0.3"/>
    <material name="target_mat" rgba="0.10 0.85 0.25 0.45"/>
  </asset>

  <worldbody>
    <body name="cube" pos="0.50 -0.15 0.425">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.1"
            material="cube_mat" friction="1.5 0.01 0.001" condim="4"
            solref="0.004 1" solimp="0.95 0.99 0.001"/>
      <site name="cube_center" pos="0 0 0" size="0.004" rgba="1 1 0 1" group="4"/>
    </body>

    <body name="target" mocap="true" pos="0.50 0.20 0.4025">
      <geom name="target_geom" type="box" size="0.035 0.035 0.0025"
            material="target_mat" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0.0225" size="0.004" rgba="0 1 0 1" group="4"/>
    </body>
  </worldbody>
</mujoco>
