<mujoco model="pick_place_scene">
  <!--
    Top-level scene.  Load THIS file; it pulls in the robot, table and object.
    meshdir is declared here (not in panda.xml) so paths resolve from assets/.
  -->
  <compiler angle="radian" meshdir="robot/assets" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10" gravity="0 0 -9.81"/>

  <include file="robot/panda.xml"/>
  <include file="table.xml"/>
  <include file="object.xml"/>

  <statistic center="0.5 0 0.55" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0.5 0 2.2" dir="0 0 -1" directional="true" castshadow="true"/>
    <light name="fill_light" pos="1.5 -1.5 1.5" dir="-1 1 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Fixed camera framing the whole scene (arm, table, cube, target) -->
    <camera name="overview" pos="1.55 -1.25 1.25" xyaxes="0.63 0.78 0  -0.33 0.27 0.90"/>
    <!-- Top-down camera: handy for the future camera-based perception module -->
    <camera name="topdown" pos="0.55 0 1.5" xyaxes="0 -1 0  1 0 0"/>
  </worldbody>

  <keyframe>
    <!-- qpos = 7 arm joints, 2 finger joints, cube (x y z qw qx qy qz).  Home arm pose: gripper pointing down, ~0.22 m above the table centre. -->
    <key name="home"
         qpos="0 0.00858 0 -2.36188 0 2.37046 -0.7853  0.04 0.04  0.50 -0.15 0.425 1 0 0 0"
         ctrl="0 0.00858 0 -2.36188 0 2.37046 -0.7853  255"
         mpos="0.50 0.20 0.4025"/>
  </keyframe>
</mujoco>
